<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Multi-Function Calculator"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Number Checker Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Part A: Number Checker"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter a number"
            android:inputType="numberSigned"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check Number" />

        <TextView
            android:id="@+id/tvNumberResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Number checking results will appear here."
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Student Grade Calculator Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Part B: Student Grade Calculator"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etSubject1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subject 1 Marks (out of 100)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSubject2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subject 2 Marks (out of 100)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSubject3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subject 3 Marks (out of 100)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSubject4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subject 4 Marks (out of 100)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSubject5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subject 5 Marks (out of 100)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate Grade" />

        <TextView
            android:id="@+id/tvGradeResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total, percentage and grade will appear here."
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
